	)
	(text "X1 D2/D4 are named X_GPMC0_AD8/AD9 in the pinout tables. Table 31 is what"
		(exclude_from_sim no)
		(at 63.5 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c6cee12f-2a3c-4ba5-b198-88ec84b72d1a")
	)
	(text "shows the module also drives them as VOUT0_DATA16/DATA17."
		(exclude_from_sim no)
		(at 63.5 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cbb1a8a6-99a1-498c-b865-296b98fcfa92")
	)
	(text "*** may load DPI_R6 or DPI_R7 -- no pull-up, pull-down or termination."
		(exclude_from_sim no)
		(at 63.5 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ec46509c-d89f-458c-b733-01d325ea70d6")
	)
	(text "  VOUT0_DATA<n> = DPI_PIXEL[n];  channel = BGR[n/6], bit = 2 + n%6."
