	(text "*** selection, strapped high by 100K on the module. Nothing on this board"
		(exclude_from_sim no)
		(at 63.5 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b73cbef-8a87-44e4-8e22-7a0751febfe5")
	)
	(text "  VOUT0_DATA<n> = DPI_PIXEL[n];  channel = BGR[n/6], bit = 2 + n%6."
		(exclude_from_sim no)
		(at 63.5 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1253bb1f-2e47-4681-b1ff-ad1d21953a1f")
	)
	(text "  RGB666 keeps the top six bits of each channel, so bit 2 is the LSB."
		(exclude_from_sim no)
		(at 63.5 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a4edc45-4910-4ac1-b5f9-48f8e497e076")
	)
	(text "*** may load DPI_R6 or DPI_R7 -- no pull-up, pull-down or termination."
		(exclude_from_sim no)
		(at 63.5 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1b6c926b-eeb1-4dbd-9d7c-7646c644280f")
	)
	(text "X1 D2/D4 are named X_GPMC0_AD8/AD9 in the pinout tables. Table 31 is what"
