	)
	(text ""
		(exclude_from_sim no)
		(at 63.5 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "260b8d9b-2f19-4c8b-a945-3cdd15ea7157")
	)
	(text "*** The absence of components here is deliberate. See docs/som.md 2."
		(exclude_from_sim no)
		(at 63.5 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3b67eb25-9805-402d-9d7e-0b848a81f11e")
	)
	(text "  RGB666 keeps the top six bits of each channel, so bit 2 is the LSB."
		(exclude_from_sim no)
		(at 63.5 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d92907a-9b89-4734-b3d3-e2a541af5d93")
	)
	(text "*** may load DPI_R6 or DPI_R7 -- no pull-up, pull-down or termination."
		(exclude_from_sim no)
		(at 63.5 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "56446d20-2064-4455-924e-ff46db46a1da")
	)
	(text ""
		(exclude_from_sim no)
		(at 63.5 175.26 0)
		(effects
