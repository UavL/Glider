	(text "shows the module also drives them as VOUT0_DATA16/DATA17."
		(exclude_from_sim no)
		(at 63.5 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "af81e6c8-74d3-4b28-a4a1-5053296ea4c3")
	)
	(text "  VOUT0_DATA<n> = DPI_PIXEL[n];  channel = BGR[n/6], bit = 2 + n%6."
		(exclude_from_sim no)
		(at 63.5 182.88 0)
		(effects
			(font
