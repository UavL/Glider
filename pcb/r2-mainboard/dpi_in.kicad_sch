	(text "BOOTMODE bits 8 and 9: these two DPI lines are GPMC0_AD8/AD9. Bit 8 = 0, bit 9 = 1 (MMC port 1 = SD card) - docs/sic.md 6"
		(exclude_from_sim yes)
		(at 71.12 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "368315ba-7fd4-4772-9d8f-8745ef43d704")
	)
	(text "  RGB666 keeps the top six bits of each channel, so bit 2 is the LSB."
