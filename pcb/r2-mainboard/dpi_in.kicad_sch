	(text "*** selection, strapped high by 100K on the module. Nothing on this board"
		(exclude_from_sim no)
		(at 63.5 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "23dfe533-dd70-49e0-af28-5ba306a1abeb")
	)
	(text "*** D2 and D4 are also BOOTMODE_8 and BOOTMODE_9, the primary boot mode"
		(exclude_from_sim no)
		(at 63.5 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c976bfc-09c8-4cc3-99dd-1453d97076b1")
	)
	(text "  RGB666 keeps the top six bits of each channel, so bit 2 is the LSB."
		(exclude_from_sim no)
		(at 63.5 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "31ed0e05-49df-440d-8c7f-b75d5ecff96d")
	)
	(text "*** The absence of components here is deliberate. See docs/som.md 2."
		(exclude_from_sim no)
		(at 63.5 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "405ea809-14eb-4de6-be79-9d5afc152b85")
	)
	(text "dpi_in -- the SoM's 18-bit RGB666 output into Caster. 22 signals, no parts."
		(exclude_from_sim no)
		(at 63.5 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5cebfddd-befe-4721-830d-884a08ab8ddc")
	)
	(text "Bit mapping, from AM62x TRM Fig. 12-471 and Caster constraint.ucf:"
