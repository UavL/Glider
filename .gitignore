build/
.DS_Store
__pycache__/
*.pyc
*.bak
*-backups/
#auto_saved_files#
*.lck
gerber/
production/
fp-info-cache
fabrication-toolkit-options.json
*.kicad_sch-bak
# MCUXpresso files
Debug/

# Generated by the STM32CubeIDE build
fw/User/git_hash.h
*.o
utils/flash_tool/cfggen/bin

# KiCad per-user state
pcb/r2-mainboard/*.kicad_prl
pcb/r2-mainboard/fp-info-cache
pcb/r2-mainboard/*-backups/

# Vendor reference manuals -- too large to version, fetch from TI instead
# (AM62x TRM: https://www.ti.com/lit/pdf/spruiv7)
AM62xTechnicalReferenceManual*.pdf

# Scratch output from schematic-analysis tooling
analysis/

# KiCad Local History restore leftovers -- see the memory note; Restore moves the
# *newer* work here, so check before deleting one of these.
pcb/r2-mainboard/_restore_backup_*/

# editor swap files
*.kate-swp

# saved copies of published artifact pages
/Reflow R2 System Map.html
/Reflow R2 System Map_files/

# PHYTEC's 3D archive (pcb/r2-mainboard/datasheets/SoM Phycore AM62x/).
# The .zip is committed, so everything here is recoverable with `unzip`.
# The DXF is committed *extracted* as well, because gen_som_footprint.py cites
# it as the source for the PCM-071 land pattern and parses it directly --
# see som.md section 11. The other three are 49 MB of 3D that only the
# enclosure work needs.
pcb/r2-mainboard/datasheets/**/PCM-071_1573-1.STEP
pcb/r2-mainboard/datasheets/**/PCM-071_1573-1.x_t
pcb/r2-mainboard/datasheets/**/PCM-071_1573-1_Basic.step

# The corrected KiCad global footprint library table, if one is ever left here.
# tools/fix_kicad_paths.sh generates it from the running install (layout.md §9),
# so it is machine-specific and never committed.
pcb/r2-mainboard/fp-lib-table.fixed

# KiCad "Update PCB from Schematic" report, saved for diagnosis (layout.md §9)
pcb/r2-mainboard/report.txt

# Timestamped board backups written by tools/place_som.py
pcb/r2-mainboard/*.kicad_pcb.bak-*

# tool backups -- kept on disk, not in history
pcb/r2-mainboard/*.bak-*
